# PortLab MCP Server 环境变量示例
# docker compose 会从根目录 .env 读取；以下为本服务专用项，可按需复制

# PortLab backend API 基址（含 /api 前缀）。
# 容器间走服务名：http://backend:8010/api
# 本地裸跑：http://localhost:8010/api
PORTLAB_API_BASE=http://localhost:8010/api

# MCP server 监听端口（Streamable HTTP，路径 /mcp）
MCP_HTTP_PORT=8020

# 监听地址（容器内需 0.0.0.0）
MCP_HOST=0.0.0.0

# 契约表路径（compose 以只读卷挂载 docs/api-registry.yaml 到此）
REGISTRY_PATH=/app/api-registry.yaml

# chart 降采样目标点数（单次回测曲线默认 ~80 点，防 LLM 上下文爆炸）
MCP_CHART_TARGET_POINTS=80
