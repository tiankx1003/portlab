# PortLab 环境变量示例 —— 复制为 .env 后按需修改
# docker compose 会自动读取同目录的 .env 文件

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=portlab
MYSQL_USER=portlab
MYSQL_PASSWORD=portlabpass

# ---- Backend ----
# DB_HOST 在容器内固定为 mysql（compose 服务名），本地裸跑时改为 127.0.0.1
DB_HOST=mysql
DB_PORT=3306
DB_USER=portlab
DB_PASS=portlabpass
DB_NAME=portlab

# 数据拉取数据源（当前支持 akshare）
DATA_SOURCE=akshare

# Tushare Pro Token（可选，留空则在右上角钥匙图标中设置；数据库中的 Token 优先级更高）
TUSHARE_TOKEN=

# 事件看板 LLM 智能匹配（OpenAI 兼容协议：OpenAI / DeepSeek / 通义千问等）。
# 可选，留空则在「事件看板 → LLM 设置」面板填写；数据库 llm_config 优先级更高。
# ⚠ 事件描述将发送至配置的大模型服务，请勿输入敏感信息。
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# ---- Frontend ----
# dev server 端口（容器内外一致，docker-compose 端口映射也用它）
VITE_PORT=5173
# /api 代理目标：容器内默认 http://backend:8010；本地裸跑改 http://127.0.0.1:8010
VITE_BACKEND_TARGET=http://backend:8010
# Vite host 白名单（绕过 DNS rebinding 防护），逗号分隔，留空则仅允许 localhost
# 用自定义域名/IP 访问 dev server 时需把对应 host 加入，如 'myhost,1.2.3.4'
VITE_ALLOWED_HOSTS=
